{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "enabled_providers": [
    "deepseek",
    "openai"
  ],
  "provider": {
    "deepseek": {
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-flash": {
          "name": "DeepSeek Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ],
          },
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "limit": {
            "context": 400000,
            "output": 128000
          }
        },
        "gpt-5.4-nano": {
          "name": "GPT-5.4 Nano"
        }
      }
    }
  },
  "agent": {
    "build": {
      "disable": false
    },
    "plan": {
      "disable": false
    }
  }
}
