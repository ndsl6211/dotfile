{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git#v7.0.2"],
  "experimental": {
    "todo": true
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      }
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "deepseek", "effect": "allow" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" }
  ],
  "providers": {
    "deepseek": {
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-flash": {
          "name": "DeepSeek Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "settings": {
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "limit": {
            "context": 400000,
            "output": 128000
          }
        },
        "gpt-5.4-nano": {
          "name": "GPT-5.4 Nano"
        }
      }
    }
  },
  "agents": {
    "build": {
      "disabled": false
    },
    "plan": {
      "disabled": false
    }
  }
}
